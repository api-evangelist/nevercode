{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codemagic App Previews Team Invitations API",
    "version": "v3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-auth-token",
      "value": "{{x-auth-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Team Invitations",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Accept a team invitation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://codemagic.io/api/v3/invitations/:code/accept",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Accept a team invitation"
        },
        {
          "info": {
            "name": "List pending team invitations",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://codemagic.io/api/v3/teams/:team_id/invitations",
            "params": [
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The maximum number of results per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number of the results to fetch."
              },
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List pending team invitations"
        },
        {
          "info": {
            "name": "Create a team invitation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://codemagic.io/api/v3/teams/:team_id/invitations",
            "params": [
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a team invitation"
        },
        {
          "info": {
            "name": "Get team invitation by code",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://codemagic.io/api/v3/invitations/public/:code",
            "params": [
              {
                "name": "code",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get team invitation by code"
        },
        {
          "info": {
            "name": "Revoke a team invitation",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://codemagic.io/api/v3/teams/:team_id/invitations/:invitation_id",
            "params": [
              {
                "name": "invitation_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Revoke a team invitation"
        }
      ]
    }
  ],
  "bundled": true
}