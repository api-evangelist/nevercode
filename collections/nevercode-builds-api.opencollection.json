{
  "opencollection": "1.0.0",
  "info": {
    "name": "Codemagic App Previews Builds API",
    "version": "v3.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "x-auth-token",
      "value": "{{x-auth-token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Builds",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get build info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://codemagic.io/api/v3/builds/:build_id",
            "params": [
              {
                "name": "build_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get build info"
        },
        {
          "info": {
            "name": "Get build remote access info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://codemagic.io/api/v3/builds/:build_id/remote-access",
            "params": [
              {
                "name": "build_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get build remote access info"
        },
        {
          "info": {
            "name": "Get build actions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://codemagic.io/api/v3/builds/:build_id/actions",
            "params": [
              {
                "name": "build_id",
                "value": "",
                "type": "path"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The maximum number of results per page."
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The page number of the results to fetch."
              }
            ]
          },
          "docs": "Get build actions"
        },
        {
          "info": {
            "name": "List team builds",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://codemagic.io/api/v3/teams/:team_id/builds",
            "params": [
              {
                "name": "app_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "workflow_id",
                "value": "",
                "type": "query"
              },
              {
                "name": "branch",
                "value": "",
                "type": "query"
              },
              {
                "name": "tag",
                "value": "",
                "type": "query"
              },
              {
                "name": "label",
                "value": "",
                "type": "query"
              },
              {
                "name": "cursor",
                "value": "",
                "type": "query",
                "description": "A unique identifier after which the results should be returned."
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query",
                "description": "The maximum number of results per page."
              },
              {
                "name": "team_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List team builds"
        }
      ]
    }
  ],
  "bundled": true
}